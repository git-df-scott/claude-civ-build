<?xml version="1.0" encoding="utf-8"?>
<Mod id="a1b2c3d4-0000-4000-9000-civbridge0001" version="1">
  <Properties>
    <Name>CivAgentBridge</Name>
    <Description>Agent bridge: dumps game state on local turn start and executes queued agent commands. Transport is the tuner console (verified: io library is nil in UI Lua, so in-sandbox file I/O is impossible; the Python daemon owns the bridge files).</Description>
    <Teaser>External agent bridge</Teaser>
    <Authors>Duncan</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="CivAgentBridgeUI">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>Bridge.lua</File>
      <File>Bridge.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <Files>
    <File>Bridge.lua</File>
    <File>Bridge.xml</File>
    <File>Utils.lua</File>
    <File>StateDump.lua</File>
    <File>CommandIntake.lua</File>
  </Files>
</Mod>
